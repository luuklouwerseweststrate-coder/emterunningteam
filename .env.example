# Strava API - maak aan op https://www.strava.com/settings/api
STRAVA_CLIENT_ID=jouw_client_id
STRAVA_CLIENT_SECRET=jouw_client_secret

# Deze krijg je na de eerste OAuth flow (de callback pagina toont ze)
STRAVA_REFRESH_TOKEN=
STRAVA_ATHLETE_ID=

# Base URL van je site
NEXT_PUBLIC_BASE_URL=https://emterunningteam.vercel.app
